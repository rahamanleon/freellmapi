# Local-only secrets for running the backup receiver's REAL tests.
#
# This file is git-ignored (see the root .gitignore, "backup receiver secrets").
# It is never printed by any script: loaders set process.env and that is all.
#
# Copy or edit these values, then run:
#   node scripts/run-tests.mjs
#
# The same MONGODB_URI and BACKUP_TOKEN values must be set as Wrangler secrets
# on the deployed Worker:
#   npx wrangler secret put MONGODB_URI
#   npx wrangler secret put BACKUP_TOKEN

MONGODB_URI=
BACKUP_TOKEN=
